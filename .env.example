# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model & Reasoning Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
THINKING_LEVEL=low

# Hotkey to toggle Overlay Chat
HOTKEY=alt+space

# Voice Settings (J.A.R.V.I.S. Tone for edge-tts)
TTS_ENABLED=true
# Thai Voice
TTS_VOICE_TH=th-TH-NiwatNeural
TTS_PITCH_TH=-14Hz
TTS_RATE_TH=+6%
TTS_VOLUME_TH=+40%
# British English Voice
TTS_VOICE_EN=en-GB-RyanNeural
TTS_PITCH_EN=-8Hz
TTS_RATE_EN=+8%
TTS_VOLUME_EN=+40%

# Antigravity Bridge Settings
ANTIGRAVITY_WINDOW_TITLE=Antigravity
TASK_FILE_NAME=.jarvis_task.md
RESULT_FILE_NAME=.jarvis_result.md

# Voice Listener Settings (1-Tap Toggle & Wake Word)
VOICE_INPUT_ENABLED=true
VOICE_LISTEN_MODE=hybrid
VOICE_TOGGLE_HOTKEY=<cmd>+<shift>+j

# Speech-to-Text (STT) Settings: "groq" (default) or "local"
STT_MODE=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local Faster-Whisper Fallback Settings (Offline / Fallback)
WHISPER_MODEL=small
WHISPER_MODEL_SIZE=small
WHISPER_INITIAL_PROMPT=จาร์วิส, เปิดแอป Firefox, Google Chrome, YouTube, Spotify, ค้นหาเพลง Love 3000, Application Support
WAKE_WORDS=hi jarvis,jarvis,จาร์วิส,จาวิส,ไฮ จาร์วิส

# Auto-close listening timeout (10 to 25 seconds) & Cooldown
VOICE_RECORD_TIMEOUT=15
VOICE_COOLDOWN_SECONDS=1.5
VOICE_POST_SPEECH_SILENCE=3.5
VOICE_ENERGY_THRESHOLD=0.015

# Memory History Limit
MAX_HISTORY_TURNS=6
