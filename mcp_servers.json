{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Volumes/WorkDrive/Javis Project"
      ]
    },
    "fetch": {
      "command": "python3",
      "args": [
        "-m",
        "mcp_server_fetch"
      ]
    },
    "git": {
      "command": "python3",
      "args": [
        "-m",
        "mcp_server_git",
        "--repository",
        "/Volumes/WorkDrive/Javis Project"
      ]
    }
  }
}
